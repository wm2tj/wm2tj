# wm2tj settings
# タブの文字: Xft のフォント名（既定 "Noto Sans CJK JP:style=Bold:pixelsize=13"）
# font "Noto Sans CJK JP:style=Bold:pixelsize=13"
menufont "Noto Sans CJK JP-10"
# メニューの一番上の項目（端末）。new_window が無いか、そのコマンドが無ければ
# $TERMINAL → x-terminal-emulator（ディストリの既定）→ xfce4-terminal → gnome-terminal → … → xterm の順に探す。
# new_window は行の残り全部（引数込み）を /bin/sh で実行する。"" や $HOME も使える
#   Top entry of the root menu (a terminal). Without new_window, or if its program is
#   missing: $TERMINAL, x-terminal-emulator (the distribution's default), ..., xterm.
#   new_window runs the rest of the line, arguments included, through /bin/sh. e.g.:
# new_window xfce4-terminal
# new_window tilix --new-process --session="$HOME/.config/tilix/sessions/two-pane.json"
new_label "Terminal"          # 例: new_label "ターミナル"。none で項目を出さない (none hides it)
desktops 3            # 仮想デスクトップの数 (virtual desktops; the built-in default is 1)
tab_length 220        # タブの長さ(px)。0 でタイトルに合わせて伸縮
# tab_width 32        # タブの太さ(px)。既定32、0 でフォントの高さ+4
double_click_time 1300   # タブのダブルクリック(最大化)とみなす間隔(ms)

# 右クリックメニュー (the root menu)
submenu_prefix "▶ "       # フォルダの頭の印 (mark before a folder name; "" for none)
# submenu_style cascade   # フォルダはメニューの横に開く (folders open beside the menu; "replace" swaps it)
# search_label "Search..." # 先頭の検索欄の文字 (text in the search row; none hides the row)

# 色（色名 or "#RRGGBB"）。`#` 始まりは "" で囲む。反映は pkill -HUP -x wm2tj
# 既定＝青い光沢タブ＋白文字＋黒い細枠（下の値）。灰色の元の見た目は
#   tab_gloss none / tab_foreground black / button_background gray95 / borders black
# tab_gloss         "#2a7de1"  # 光沢グラデーションの基調色（none で単色 tab_background）
# tab_foreground    white      # タブの文字
# button_background "#1a4f9c"  # タブの閉じるボタン
# borders           black      # 枠線（none で線なし）
# tab_background    gray80     # 単色タブの色（tab_gloss none のとき）
# frame_background  gray95     # 枠
# menu_background   gray80
# menu_foreground   black
# border 7                     # 枠の太さ。7 未満にすると窓の形が崩れる
