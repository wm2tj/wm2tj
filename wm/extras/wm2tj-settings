#!/usr/bin/env python3
# wm2tj-settings - a settings window for wm2tj (~/.wm2rc).
#
# "Apply" rewrites only the values of the keys that changed (comments and the
# other lines stay as they are), adds the missing keys before the marker line
# of wm2-menu-gen, and restarts wm2tj in place (SIGHUP). Before the first change
# .wm2rc is copied once to ~/.wm2rc.bak-wm2tj-settings.
#
# Needs python3, PyGObject and GTK 3. Text domain "wm2tj".
import gettext, os, re, shutil, subprocess, sys
try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gtk, Gdk, GLib
except (ImportError, ValueError) as e:
    sys.exit(f"{sys.argv[0]}: needs PyGObject with GTK 3 (python3-gi, python-gobject, py3-gobject3): {e}")

TEXTDOMAIN = "wm2tj"
LOCALEDIR = "@LOCALEDIR@"	# filled in by make install
if LOCALEDIR.startswith("@"):
    LOCALEDIR = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])),
                             "..", "share", "locale")
gettext.bindtextdomain(TEXTDOMAIN, LOCALEDIR)
gettext.textdomain(TEXTDOMAIN)
_ = gettext.gettext

RC = os.path.expanduser("~/.wm2rc")
BACKUP = RC + ".bak-wm2tj-settings"
MARKER = "# --- menu generated by wm2-menu-gen"
WM_NAMES = ("wm2", "wm2tj")
# wm2tj-bar takes the tab colours and font from ~/.wm2rc too
BAR_NAMES = ("wm2tj-bar",)

# wm2tj's defaults (as setDefaults in Config.C)
DEFAULTS = {
    "font": "Noto Sans CJK JP:style=Bold:pixelsize=13",
    "menufont": "Hack-11",
    "tab_gloss": "#2a7de1",
    "tab_background": "gray80",
    "tab_foreground": "white",
    "button_background": "#1a4f9c",
    "frame_background": "gray95",
    "borders": "black",
    "left_line": "auto",
    "menu_background": "gray80",
    "menu_foreground": "black",
    "menu_borders": "auto",   # auto = the tab colour (as the left line)
    "submenu_prefix": "",
}


# ---- reading and writing ~/.wm2rc ----------------------------------------------

def tokenize_value(rest):
    """'  "a b"  # c' -> ('a b', start, end), by the rules of wm2tj's readToken."""
    i = len(rest) - len(rest.lstrip())
    if i >= len(rest) or rest[i] == "#":
        return None, i, i
    if rest[i] == '"':
        j = rest.find('"', i + 1)
        if j < 0:
            return rest[i + 1:].rstrip("\n"), i, len(rest.rstrip("\n"))
        return rest[i + 1:j], i, j + 1
    j = i
    while j < len(rest) and not rest[j].isspace():
        j += 1
    return rest[i:j], i, j


class Wm2rc:
    def __init__(self, path):
        self.path = path
        self.reload()

    def reload(self):
        try:
            with open(self.path, encoding="utf-8") as f:
                self.lines = f.read().splitlines(keepends=True)
        except FileNotFoundError:
            self.lines = []

    def _top_level(self):
        """(line, key, value, value start, value end), outside submenus only."""
        depth = 0
        for n, line in enumerate(self.lines):
            s = line.strip()
            if s.startswith(MARKER):
                break
            if not s or s.startswith("#"):
                continue
            if s.endswith("{"):
                depth += 1
                continue
            if s == "}":
                depth = max(0, depth - 1)
                continue
            if depth:
                continue
            m = re.match(r"\s*(\S+)", line)
            key = m.group(1)
            val, start, end = tokenize_value(line[m.end():])
            if val is not None:
                yield n, key, val, m.end() + start, m.end() + end

    def get(self, key):
        val = None
        for _, k, v, _, _ in self._top_level():
            if k == key:
                val = v          # in wm2tj the last line wins
        return val

    def set(self, key, value):
        q = quote(value)
        last = None
        for n, k, _, start, end in self._top_level():
            if k == key:
                last = (n, start, end)
        if last:
            n, start, end = last
            line = self.lines[n]
            self.lines[n] = line[:start] + q + line[end:]
            return
        new = "%s %s   # wm2tj-settings\n" % (key, q)
        for n, line in enumerate(self.lines):
            if line.strip().startswith(MARKER):
                self.lines.insert(n, new)
                return
        if self.lines and not self.lines[-1].endswith("\n"):
            self.lines[-1] += "\n"
        self.lines.append(new)

    def save(self):
        if os.path.exists(self.path) and not os.path.exists(BACKUP):
            shutil.copy2(self.path, BACKUP)
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("".join(self.lines))
        os.replace(tmp, self.path)


def quote(v):
    if v == "" or re.search(r'[\s#"]', v) or v.startswith("#"):
        return '"%s"' % v.replace('"', "")
    return v


# ---- colours -------------------------------------------------------------

_X_COLORS = None


def x_colors():
    global _X_COLORS
    if _X_COLORS is None:
        _X_COLORS = {}
        for p in ("/usr/share/X11/rgb.txt", "/etc/X11/rgb.txt"):
            try:
                with open(p) as f:
                    for line in f:
                        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\d+)\s+(.+?)\s*$", line)
                        if m:
                            name = m.group(4).lower().replace(" ", "")
                            _X_COLORS[name] = tuple(int(m.group(i)) for i in (1, 2, 3))
                break
            except OSError:
                pass
    return _X_COLORS


def to_rgba(text):
    rgba = Gdk.RGBA()
    rgb = x_colors().get(text.lower().replace(" ", "")) if text else None
    if rgb:
        rgba.red, rgba.green, rgba.blue = (c / 255 for c in rgb)
        rgba.alpha = 1
    elif not (text and rgba.parse(text)):
        rgba.parse("gray")
    return rgba


def to_hex(rgba):
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in (rgba.red, rgba.green, rgba.blue))


class ColorField(Gtk.Box):
    """Colour button + the value as text (white, #2a7de1...); kept as written unless changed."""
    def __init__(self, text):
        super().__init__(spacing=8)
        self.button = Gtk.ColorButton.new_with_rgba(to_rgba(text))
        self.label = Gtk.Label(xalign=0)
        self.label.get_style_context().add_class("dim-label")
        self.button.connect("color-set", self.on_set)
        self.pack_start(self.button, False, False, 0)
        self.pack_start(self.label, False, False, 0)
        self.set_text(text)

    def set_text(self, text):
        self.text = text
        self.button.set_rgba(to_rgba(text))
        self.label.set_text(text)

    def on_set(self, *a):
        self.text = to_hex(self.button.get_rgba())
        self.label.set_text(self.text)

    def get_text(self):
        return self.text


# ---- fonts (Xft names <-> the font chooser) ---------------------------

def parse_xft(name):
    """'Family:style=Bold:pixelsize=12' / 'Family-10' -> (family, style, size, unit)"""
    parts = name.split(":")
    head, props = parts[0], parts[1:]
    size, unit = None, "pt"
    m = re.match(r"(.*?)-(\d+(?:\.\d+)?)$", head)
    if m:
        head, size = m.group(1), float(m.group(2))
    style = ""
    for p in props:
        k, _, v = p.partition("=")
        if k == "style":
            style = v
        elif k == "pixelsize":
            size, unit = float(v), "px"
        elif k == "size":
            size, unit = float(v), "pt"
        elif k == "weight" and not style:
            style = v.capitalize()
        elif k in ("bold", "italic") and not v:
            style = (style + " " + k.capitalize()).strip()
    return head.strip(), style, size or 10, unit


def make_xft(family, style, size, unit):
    s = family
    if style and style.lower() not in ("regular", "normal", "book"):
        s += ":style=" + style
    n = int(size) if size == int(size) else size
    s += (":pixelsize=%s" if unit == "px" else ":size=%s") % n
    return s


class FontField(Gtk.Box):
    """Font (family, style) chooser + size (in px or pt, as it was written)."""
    def __init__(self, text):
        super().__init__(spacing=8)
        self.button = Gtk.FontButton()
        self.button.set_level(Gtk.FontChooserLevel.FAMILY | Gtk.FontChooserLevel.STYLE)
        self.button.set_use_font(True)
        self.size = Gtk.SpinButton.new_with_range(5, 72, 1)
        self.unit = Gtk.Label()
        self.pack_start(self.button, True, True, 0)
        self.pack_start(self.size, False, False, 0)
        self.pack_start(self.unit, False, False, 0)
        self.set_text(text)

    def set_text(self, text):
        self.original = text
        family, style, size, self.u = parse_xft(text)
        self.button.set_font("%s %s %d" % (family, style, size))
        self.size.set_value(size)
        self.unit.set_text(self.u)
        self.start = (family, style, size)

    def get_text(self):
        fam = self.button.get_font_family()
        face = self.button.get_font_face()
        family = fam.get_name() if fam else self.start[0]
        style = face.get_face_name() if face else self.start[1]
        new = make_xft(family, style, self.size.get_value(), self.u)
        if new == make_xft(*self.start, self.u):   # untouched: keep it as written
            return self.original
        return new


# ---- the window -----------------------------------------------------------

class SettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("wm2tj Settings"))
        self.set_default_size(560, -1)
        self.set_border_width(10)
        self.connect("destroy", Gtk.main_quit)
        self.rc = Wm2rc(RC)
        self.fields = {}

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(box)
        self.notebook = Gtk.Notebook()
        self.notebook.append_page(self.appearance_page(), Gtk.Label(label=_("Appearance")))
        box.pack_start(self.notebook, True, True, 0)

        btns = Gtk.Box(spacing=6)
        revert = Gtk.Button(label=_("Revert"))
        revert.set_tooltip_text(_("Discard the changes not applied yet and reread ~/.wm2rc"))
        revert.connect("clicked", lambda *a: self.load())
        apply = Gtk.Button(label=_("Apply"))
        apply.get_style_context().add_class("suggested-action")
        apply.connect("clicked", lambda *a: self.apply())
        self.status = Gtk.Label(xalign=0)
        self.status.get_style_context().add_class("dim-label")
        btns.pack_start(revert, False, False, 0)
        btns.pack_start(self.status, True, True, 0)
        btns.pack_end(apply, False, False, 0)
        box.pack_start(btns, False, False, 0)

        self.load()

    def value(self, key):
        v = self.rc.get(key)
        return DEFAULTS[key] if v is None else v

    # the Appearance page
    def appearance_page(self):
        grid = Gtk.Grid(row_spacing=8, column_spacing=12, border_width=12)
        self.row = 0

        def heading(text):
            lab = Gtk.Label(xalign=0)
            lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(text))
            if self.row:
                lab.set_margin_top(8)
            grid.attach(lab, 0, self.row, 2, 1)
            self.row += 1

        def add(label, widget, key=None):
            grid.attach(Gtk.Label(label=label, xalign=1), 0, self.row, 1, 1)
            grid.attach(widget, 1, self.row, 1, 1)
            widget.set_hexpand(True)
            if key:
                self.fields[key] = widget
            self.row += 1

        heading(_("Window tab"))
        gloss = Gtk.Box(spacing=12)
        self.gloss_color = ColorField(DEFAULTS["tab_gloss"])
        self.gloss_off = Gtk.CheckButton(label=_("No gloss (flat)"))
        self.gloss_off.connect("toggled", lambda *a: self.update_sensitive())
        gloss.pack_start(self.gloss_color, False, False, 0)
        gloss.pack_start(self.gloss_off, False, False, 0)
        add(_("Gloss colour"), gloss)
        self.flat_color = ColorField(DEFAULTS["tab_background"])
        add(_("Flat colour"), self.flat_color, "tab_background")
        add(_("Text colour"), ColorField(DEFAULTS["tab_foreground"]), "tab_foreground")
        add(_("Close button"), ColorField(DEFAULTS["button_background"]), "button_background")
        add(_("Font"), FontField(DEFAULTS["font"]), "font")

        heading(_("Frame"))
        add(_("Frame colour"), ColorField(DEFAULTS["frame_background"]), "frame_background")
        bd = Gtk.Box(spacing=12)
        self.bd_color = ColorField(DEFAULTS["borders"])
        self.bd_none = Gtk.CheckButton(label=_("None"))
        self.bd_none.connect("toggled", lambda *a: self.update_sensitive())
        bd.pack_start(self.bd_color, False, False, 0)
        bd.pack_start(self.bd_none, False, False, 0)
        add(_("Border colour"), bd)
        left = Gtk.Box(spacing=12)
        self.left_auto = Gtk.RadioButton.new_with_label(None, _("Same as the top line"))
        self.left_none = Gtk.RadioButton.new_with_label_from_widget(self.left_auto, _("None"))
        self.left_custom = Gtk.RadioButton.new_with_label_from_widget(self.left_auto, _("Colour:"))
        self.left_color = ColorField("#2a7de1")
        for w in (self.left_auto, self.left_none, self.left_custom):
            w.connect("toggled", lambda *a: self.update_sensitive())
            left.pack_start(w, False, False, 0)
        left.pack_start(self.left_color, False, False, 0)
        add(_("Left line"), left)

        heading(_("Root menu"))
        add(_("Background colour"), ColorField(DEFAULTS["menu_background"]), "menu_background")
        add(_("Text colour"), ColorField(DEFAULTS["menu_foreground"]), "menu_foreground")
        mb = Gtk.Box(spacing=12)
        self.mb_color = ColorField("black")
        self.mb_auto = Gtk.CheckButton(label=_("Same as the tab colour"))
        self.mb_auto.connect("toggled", lambda *a: self.update_sensitive())
        mb.pack_start(self.mb_color, False, False, 0)
        mb.pack_start(self.mb_auto, False, False, 0)
        add(_("Border colour"), mb)
        add(_("Font"), FontField(DEFAULTS["menufont"]), "menufont")
        prefix = Gtk.Entry(width_chars=6, hexpand=False)
        prefix.set_tooltip_text(_("Mark put before folder names (e.g. ▶ ). If empty, a > follows the name"))
        add(_("Folder mark"), prefix, "submenu_prefix")

        return grid

    def update_sensitive(self):
        off = self.gloss_off.get_active()
        self.gloss_color.set_sensitive(not off)
        self.flat_color.set_sensitive(off)
        self.bd_color.set_sensitive(not self.bd_none.get_active())
        self.left_color.set_sensitive(self.left_custom.get_active())
        self.mb_color.set_sensitive(not self.mb_auto.get_active())

    def load(self):
        self.rc.reload()
        self.loaded = {}
        for key, w in self.fields.items():
            v = self.value(key)
            self.loaded[key] = v
            w.set_text(v)
        gloss = self.value("tab_gloss")
        self.loaded["tab_gloss"] = gloss
        self.gloss_off.set_active(gloss == "none")
        self.gloss_color.set_text(DEFAULTS["tab_gloss"] if gloss == "none" else gloss)
        bd = self.value("borders")
        self.loaded["borders"] = bd
        self.bd_none.set_active(bd == "none")
        self.bd_color.set_text(DEFAULTS["borders"] if bd == "none" else bd)
        left = self.value("left_line")
        self.loaded["left_line"] = left
        if left == "auto":
            self.left_auto.set_active(True)
        elif left == "none":
            self.left_none.set_active(True)
        else:
            self.left_custom.set_active(True)
            self.left_color.set_text(left)
        mb = self.value("menu_borders")
        self.loaded["menu_borders"] = mb
        self.mb_auto.set_active(mb == "auto")
        self.mb_color.set_text((self.value("menu_background") if bd == "none" else bd)
                               if mb == "auto" else mb)
        self.update_sensitive()
        self.status.set_text("")

    def collect(self):
        vals = {key: w.get_text() for key, w in self.fields.items()}
        vals["tab_gloss"] = "none" if self.gloss_off.get_active() else self.gloss_color.get_text()
        vals["borders"] = "none" if self.bd_none.get_active() else self.bd_color.get_text()
        if self.left_auto.get_active():
            vals["left_line"] = "auto"
        elif self.left_none.get_active():
            vals["left_line"] = "none"
        else:
            vals["left_line"] = self.left_color.get_text()
        vals["menu_borders"] = "auto" if self.mb_auto.get_active() else self.mb_color.get_text()
        return vals

    def apply(self):
        self.rc.reload()   # build on any change made elsewhere
        changed = [k for k, v in self.collect().items() if v != self.loaded.get(k)]
        if not changed:
            self.status.set_text(_("Nothing changed"))
            return
        vals = self.collect()
        for k in changed:
            self.rc.set(k, vals[k])
        try:
            self.rc.save()
        except OSError as e:
            self.status.set_text(_("Cannot save: %s") % e)
            return
        for name in WM_NAMES + BAR_NAMES:
            subprocess.run(["pkill", "-HUP", "-x", name])
        self.load()
        self.status.set_text(gettext.ngettext("Saved %d setting; wm2tj has reloaded",
                                              "Saved %d settings; wm2tj has reloaded",
                                              len(changed)) % len(changed))


if __name__ == "__main__":
    SettingsWindow().show_all()
    Gtk.main()
