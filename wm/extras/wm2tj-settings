# ---- reading and writing ~/.wm2rc ----------------------------------------------

def tokenize_value(rest):
    """'  "a b"  # c' -> ('a b', start, end), by the rules of wm2tj's readToken."""
    i = len(rest) - len(rest.lstrip())
    if i >= len(rest) or rest[i] == "#":
        return None, i, i
    if rest[i] == '"':
        j = rest.find('"', i + 1)
        if j < 0:
            return rest[i + 1:].rstrip("\n"), i, len(rest.rstrip("\n"))
        return rest[i + 1:j], i, j + 1
    j = i
    while j < len(rest) and not rest[j].isspace():
        j += 1
    return rest[i:j], i, j


class Wm2rc:
    def __init__(self, path):
        self.path = path
        self.reload()

    def reload(self):
        try:
            with open(self.path, encoding="utf-8") as f:
                self.lines = f.read().splitlines(keepends=True)
        except FileNotFoundError:
            self.lines = []

    def _top_level(self):
        """(line, key, value, value start, value end), outside submenus only."""
        depth = 0
        for n, line in enumerate(self.lines):
            s = line.strip()
            if s.startswith(MARKER):
                break
            if not s or s.startswith("#"):
                continue
            if s.endswith("{"):
                depth += 1
                continue
            if s == "}":
                depth = max(0, depth - 1)
                continue
            if depth:
                continue
            m = re.match(r"\s*(\S+)", line)
            key = m.group(1)
            val, start, end = tokenize_value(line[m.end():])
            if val is not None:
                yield n, key, val, m.end() + start, m.end() + end

    def get(self, key):
        val = None
        for _, k, v, _, _ in self._top_level():
            if k == key:
                val = v          # in wm2tj the last line wins
        return val

    def set(self, key, value):
        q = quote(value)
        last = None
        for n, k, _, start, end in self._top_level():
            if k == key:
                last = (n, start, end)
        if last:
            n, start, end = last
            line = self.lines[n]
            self.lines[n] = line[:start] + q + line[end:]
            return
        new = "%s %s   # wm2tj-settings\n" % (key, q)
        for n, line in enumerate(self.lines):
            if line.strip().startswith(MARKER):
                self.lines.insert(n, new)
                return
        if self.lines and not self.lines[-1].endswith("\n"):
            self.lines[-1] += "\n"
        self.lines.append(new)

    def save(self):
        if os.path.exists(self.path) and not os.path.exists(BACKUP):
            shutil.copy2(self.path, BACKUP)
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("".join(self.lines))
        os.replace(tmp, self.path)


def quote(v):
    if v == "" or re.search(r'[\s#"]', v) or v.startswith("#"):
        return '"%s"' % v.replace('"', "")
    return v


# ---- colours -------------------------------------------------------------

_X_COLORS = None


def x_colors():
    global _X_COLORS
    if _X_COLORS is None:
        _X_COLORS = {}
        for p in ("/usr/share/X11/rgb.txt", "/etc/X11/rgb.txt"):
            try:
                with open(p) as f:
                    for line in f:
                        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\d+)\s+(.+?)\s*$", line)
                        if m:
                            name = m.group(4).lower().replace(" ", "")
                            _X_COLORS[name] = tuple(int(m.group(i)) for i in (1, 2, 3))
                break
            except OSError:
                pass
    return _X_COLORS


def to_rgba(text):
    rgba = Gdk.RGBA()
    rgb = x_colors().get(text.lower().replace(" ", "")) if text else None
    if rgb:
        rgba.red, rgba.green, rgba.blue = (c / 255 for c in rgb)
        rgba.alpha = 1
    elif not (text and rgba.parse(text)):
        rgba.parse("gray")
    return rgba


def to_hex(rgba):
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in (rgba.red, rgba.green, rgba.blue))


def same_colour(a, b):
    """'gray95' and '#f2f2f2' are the same; 'auto' / 'none' only equal themselves."""
    if a == b:
        return True
    words = ("auto", "none")
    if a in words or b in words:
        return False
    return to_hex(to_rgba(a)) == to_hex(to_rgba(b))


# ---- theme previews (a small window: the glossy tab, frame and menu) -----

def _mix(c, r, g, b, t):
    t = min(1.0, max(0.0, t))
    return [c[0] + (r - c[0]) * t, c[1] + (g - c[1]) * t, c[2] + (b - c[2]) * t]


def gloss_colour(base, s, t):
    """Border::glossColour in wm2tj: s across the tab (0 deep .. 1 light), t along it."""
    c = _mix(list(base), 0, 0.02, 0.15, 0.50 * (1 - s) ** 1.4)
    c = _mix(c, 1, 1, 1, 0.45 * s * s)
    g = (s - 0.72) / 0.10
    c = _mix(c, 1, 1, 1, 0.45 * math.exp(-g * g))
    if t < 0.3:
        c = _mix(c, 1, 1, 1, 0.25 * (1 - t / 0.3))
    return _mix(c, 0, 0, 0.1, 0.20 * t)


def theme_preview(colours, w=84, h=56):
    """A GdkPixbuf of a window in these colours (no cairo needed)."""
    rgb = lambda name: (lambda r: (r.red, r.green, r.blue))(to_rgba(name))
    desk = (0.36, 0.39, 0.44)
    pix = [[desk] * w for _ in range(h)]
    flat = colours["tab_gloss"] == "none"
    base = rgb(colours["tab_background"] if flat else colours["tab_gloss"])
    tab = (lambda s, t: base) if flat else (lambda s, t: gloss_colour(base, s, t))
    bd = None if colours["borders"] == "none" else rgb(colours["borders"])
    TW, TX, TY, TL = 12, 5, 5, h - 10         # the tab
    FX, FY, FW, FH = TX + TW, TY, w - TX - TW - 5, h - 16   # the frame
    for y in range(TL):
        for x in range(TW):
            pix[TY + y][TX + x] = tab(x / (TW - 1), y / (TL - 1))
    strip = tab(0.5, 0.0)
    frame = rgb(colours["frame_background"])
    for y in range(FH):
        for x in range(FW):
            pix[FY + y][FX + x] = frame
    for x in range(FW):
        pix[FY][FX + x] = pix[FY + 1][FX + x] = strip      # the line along the top
    if colours["left_line"] != "none" and not (flat and colours["left_line"] == "auto"):
        left = strip if colours["left_line"] == "auto" else rgb(colours["left_line"])
        for y in range(FH):
            pix[FY + y][FX] = left
    for y in range(FY + 4, FY + FH - 3):                  # the window's contents
        for x in range(FX + 4, FX + FW - 3):
            pix[y][x] = (1, 1, 1)
    btn = rgb(colours["button_background"])               # the close button
    for y in range(TY + 2, TY + 8):
        for x in range(TX + 3, TX + 9):
            pix[y][x] = btn
    if bd:
        for x in range(TX, FX + FW):
            pix[TY][x] = bd
        for x in range(TX, TX + TW):
            pix[TY + TL - 1][x] = bd
        for x in range(FX, FX + FW):
            pix[FY + FH - 1][x] = bd
        for y in range(TY, TY + TL):
            pix[y][TX] = bd
        for y in range(FY + FH, TY + TL):
            pix[y][FX] = bd
        for y in range(FY, FY + FH):
            pix[y][FX + FW - 1] = bd
    # a bit of the root menu, overlapping the lower right
    mbg, mfg = rgb(colours["menu_background"]), rgb(colours["menu_foreground"])
    mb = colours["menu_borders"]
    edge = colours["left_line"]
    if mb == "auto":     # the left line's colour, else the window borders (Buttons.C)
        if edge == "none" or (flat and edge == "auto"):
            mb = colours["borders"]
        elif edge != "auto":
            mb = edge
    mframe = strip if mb == "auto" else rgb(mb if mb != "none" else colours["menu_background"])
    MX, MY, MW, MH = w - 30, h - 24, 26, 21
    for y in range(MH):
        for x in range(MW):
            edge = x in (0, MW - 1) or y in (0, MH - 1)
            pix[MY + y][MX + x] = mframe if edge else mbg
    for i, ln in enumerate((14, 10, 16)):                 # three menu entries
        for x in range(MX + 4, MX + 4 + ln):
            pix[MY + 5 + i * 5][x] = mfg
    data = bytes(int(min(1, max(0, v)) * 255 + 0.5) for row in pix for c in row for v in c)
    return GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(data), GdkPixbuf.Colorspace.RGB,
                                           False, 8, w, h, w * 3)


class ColorField(Gtk.Box):
    """Colour button + the value as text (white, #2a7de1...); kept as written unless changed."""
    changed = None   # called after the user picks a colour (the page sets it)

    def __init__(self, text):
        super().__init__(spacing=8)
        self.button = Gtk.ColorButton.new_with_rgba(to_rgba(text))
        self.label = Gtk.Label(xalign=0)
        self.label.get_style_context().add_class("dim-label")
        self.button.connect("color-set", self.on_set)
        self.pack_start(self.button, False, False, 0)
        self.pack_start(self.label, False, False, 0)
        self.set_text(text)

    def set_text(self, text):
        self.text = text
        self.button.set_rgba(to_rgba(text))
        self.label.set_text(text)

    def on_set(self, *a):
        self.text = to_hex(self.button.get_rgba())
        self.label.set_text(self.text)
        if ColorField.changed:
            ColorField.changed()

    def get_text(self):
        return self.text


# ---- fonts (Xft names <-> the font chooser) ---------------------------

def parse_xft(name):
    """'Family:style=Bold:pixelsize=12' / 'Family-10' -> (family, style, size, unit)"""
    parts = name.split(":")
    head, props = parts[0], parts[1:]
    size, unit = None, "pt"
    m = re.match(r"(.*?)-(\d+(?:\.\d+)?)$", head)
    if m:
        head, size = m.group(1), float(m.group(2))
    style = ""
    for p in props:
        k, _, v = p.partition("=")
        if k == "style":
            style = v
        elif k == "pixelsize":
            size, unit = float(v), "px"
        elif k == "size":
            size, unit = float(v), "pt"
        elif k == "weight" and not style:
            style = v.capitalize()
        elif k in ("bold", "italic") and not v:
            style = (style + " " + k.capitalize()).strip()
    return head.strip(), style, size or 10, unit


def make_xft(family, style, size, unit):
    s = family
    if style and style.lower() not in ("regular", "normal", "book"):
        s += ":style=" + style
    n = int(size) if size == int(size) else size
    s += (":pixelsize=%s" if unit == "px" else ":size=%s") % n
    return s


class FontField(Gtk.Box):
    """Font (family, style) chooser + size (in px or pt, as it was written)."""
    def __init__(self, text):
        super().__init__(spacing=8)
        self.button = Gtk.FontButton()
        self.button.set_level(Gtk.FontChooserLevel.FAMILY | Gtk.FontChooserLevel.STYLE)
        self.button.set_use_font(True)
        self.size = Gtk.SpinButton.new_with_range(5, 72, 1)
        self.unit = Gtk.Label()
        self.pack_start(self.button, True, True, 0)
        self.pack_start(self.size, False, False, 0)
        self.pack_start(self.unit, False, False, 0)
        self.set_text(text)

    def set_text(self, text):
        self.original = text
        family, style, size, self.u = parse_xft(text)
        self.button.set_font("%s %s %d" % (family, style, size))
        self.size.set_value(size)
        self.unit.set_text(self.u)
        self.start = (family, style, size)

    def get_text(self):
        fam = self.button.get_font_family()
        face = self.button.get_font_face()
        family = fam.get_name() if fam else self.start[0]
        style = face.get_face_name() if face else self.start[1]
        new = make_xft(family, style, self.size.get_value(), self.u)
        if new == make_xft(*self.start, self.u):   # untouched: keep it as written
            return self.original
        return new


# ---- versions (the About tab) ---------------------------------------------

def version_of(exe):
    """The version an executable reports with --version ("wm2tj 0.1.0~beta10"
    -> "0.1.0~beta10"), or None if it cannot say (wm2tj before beta 10)."""
    try:
        r = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return None
    words = r.stdout.split()
    return words[-1] if r.returncode == 0 and words else None


def running(name):
    """The copy of `name` running for this user, preferably on this display:
    (version, path, replaced) or None.  The version comes from the running
    process's own executable (/proc/PID/exe), so it is right even when a newer
    one has been installed over it since (then `replaced` is True)."""
    try:
        pids = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", name],
                              capture_output=True, text=True).stdout.split()
    except OSError:
        return None
    display = os.environ.get("DISPLAY", "")

    def on_this_display(pid):
        try:
            with open(f"/proc/{pid}/environ", "rb") as f:
                return f"DISPLAY={display}".encode() in f.read().split(b"\0")
        except OSError:
            return False

    pids.sort(key=lambda p: not on_this_display(p))
    for pid in pids:
        try:
            path = os.readlink(f"/proc/{pid}/exe")
        except OSError:
            continue
        replaced = path.endswith(" (deleted)")
        if replaced:
            path = path[:-len(" (deleted)")]
        return version_of(f"/proc/{pid}/exe"), path, replaced
    return None


def package_version(pkg):
    """The installed package's version (dpkg only for now), else None."""
    if not shutil.which("dpkg-query"):
        return None
    r = subprocess.run(["dpkg-query", "-W", "-f", "${db:Status-Abbrev} ${Version}", pkg],
                       capture_output=True, text=True)
    st, _sep, ver = r.stdout.partition(" ")
    return ver.strip() if r.returncode == 0 and st.startswith("ii") else None


def os_name():
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return os.uname().sysname


