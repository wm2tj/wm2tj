    # the page as tall as its contents, up to the screen; then it scrolls
    def fit_height(self):
        self.page.show_all()
        h = min(self.page.get_preferred_height()[1], self.max_page_h)
        self.scroll.set_min_content_height(h)
        self.resize(self.get_size()[0], 1)   # shrink again when the colours close
        return False

    # the theme picked: put its colours into the fields (saved by Apply)
    def on_theme(self, button, name):
        if not button.get_active() or self.syncing:
            return
        colours = dict(THEMES[[t[0] for t in THEMES].index(name)][2])
        self.syncing = True
        flat = colours["tab_gloss"] == "none"
        self.gloss_off.set_active(flat)
        if flat:
            self.flat_color.set_text(colours["tab_background"])
        else:
            self.gloss_color.set_text(colours["tab_gloss"])
        for key in ("tab_foreground", "button_background", "frame_background",
                    "menu_background", "menu_foreground"):
            self.fields[key].set_text(colours[key])
        self.bd_none.set_active(colours["borders"] == "none")
        if colours["borders"] != "none":
            self.bd_color.set_text(colours["borders"])
        ll = colours["left_line"]
        (self.left_auto if ll == "auto" else self.left_none if ll == "none"
         else self.left_custom).set_active(True)
        if ll not in ("auto", "none"):
            self.left_color.set_text(ll)
        self.mb_auto.set_active(colours["menu_borders"] == "auto")
        if colours["menu_borders"] != "auto":
            self.mb_color.set_text(colours["menu_borders"])
        self.syncing = False
        self.update_sensitive()
        self.sync_theme()

    def matching_theme(self, vals):
        for name, _title, colours in THEMES:
            # a glossy theme leaves tab_background as it is
            if all(same_colour(vals[k], colours[k]) for k in THEME_KEYS + ("tab_background",)
                   if k in colours):
                return name
        return None

    # select the theme the colours in the fields match, else "Custom"
    def sync_theme(self):
        if self.syncing:
            return
        name = self.matching_theme(self.collect())
        self.syncing = True
        (self.theme_buttons[name] if name else self.theme_custom).set_active(True)
        self.syncing = False
        if name:
            self.theme_note.set_text("")
            self.theme_note.hide()
        else:
            self.theme_note.set_text(_("Custom colours (not one of the themes). "
                                       "Pick a theme to replace them."))
            self.theme_note.show()
        if self.loaded:
            changed = any(v != self.loaded.get(k) for k, v in self.collect().items())
            self.status.set_text(_("Press Apply to use it") if changed else "")

    # the About page: versions running and installed
    def about_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, border_width=12)
        self.about_grid = Gtk.Grid(row_spacing=6, column_spacing=12)
        box.pack_start(self.about_grid, False, False, 0)
        btns = Gtk.Box(spacing=6)
        refresh = Gtk.Button(label=_("Refresh"))
        refresh.connect("clicked", lambda *a: self.fill_about())
        copy = Gtk.Button(label=_("Copy"))
        copy.set_tooltip_text(_("Copy these lines, e.g. for a bug report"))
        copy.connect("clicked", lambda *a: Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                     .set_text(self.about_text, -1))
        btns.pack_start(refresh, False, False, 0)
        btns.pack_start(copy, False, False, 0)
        btns.pack_end(Gtk.LinkButton.new_with_label(
            "https://github.com/wm2tj/wm2tj/releases", _("Releases")), False, False, 0)
        btns.pack_end(Gtk.LinkButton.new_with_label(
            "https://wm2tj.kaie-net.com/", _("Website")), False, False, 0)
        box.pack_start(btns, False, False, 0)
        self.fill_about()
        return box

    def fill_about(self):
        for child in self.about_grid.get_children():
            self.about_grid.remove(child)
        lines = []
        row = 0

        def add(label, value, note=None, warn=False):
            nonlocal row
            self.about_grid.attach(Gtk.Label(label=label, xalign=1, yalign=0), 0, row, 1, 1)
            val = Gtk.Label(xalign=0, selectable=True, wrap=True)
            text = GLib.markup_escape_text(value)
            if note:
                text += "\n<small>%s</small>" % GLib.markup_escape_text(note)
            val.set_markup(("⚠ " if warn else "") + text)
            val.set_hexpand(True)
            self.about_grid.attach(val, 1, row, 1, 1)
            row += 1
            lines.append(f"{label}: {value}" + (" (%s)" % note.replace("\n", "; ") if note else ""))

        unknown = _("older than 0.1.0~beta10 (no --version)")
        for name, restart in (("wm2tj", _("restart wm2tj (root menu) or log in again")),
                              ("wm2tj-bar", _("restart the bar or log in again"))):
            run = running(name)
            onpath = shutil.which(name)
            if run:
                ver, path, replaced = run
                notes = [_("running: %s") % path]
                warn = False
                if replaced:
                    notes.append(_("a newer copy was installed since it started (%s): %s")
                                 % (version_of(path) or "?", restart))
                    warn = True
                elif onpath and os.path.realpath(onpath) != os.path.realpath(path):
                    notes.append(_("%s comes first on PATH (%s)")
                                 % (onpath, version_of(onpath) or unknown))
                    warn = True
                add(name, ver or unknown, "\n".join(notes), warn)
            elif onpath:
                add(name, _("not running"),
                    _("installed: %s (%s)") % (onpath, version_of(onpath) or unknown))
            else:
                add(name, _("not running"))

        add(_("Tools"), VERSION or _("unknown (not installed with make install)"),
            _("menu, settings: %s") % os.path.abspath(sys.argv[0]))
        if shutil.which("dpkg-query"):
            pk = [f"{p} {package_version(p) or _('not installed')}" for p in ("wm2tj", "wm2tj-bar")]
            add(_("Packages"), ", ".join(pk))
        add(_("System"), os_name())
        self.about_text = "\n".join(lines)
        self.about_grid.show_all()

    def update_sensitive(self):
        off = self.gloss_off.get_active()
        self.gloss_color.set_sensitive(not off)
        self.flat_color.set_sensitive(off)
        self.bd_color.set_sensitive(not self.bd_none.get_active())
        self.left_color.set_sensitive(self.left_custom.get_active())
        self.mb_color.set_sensitive(not self.mb_auto.get_active())

    def load(self):
        self.rc.reload()
        self.loaded = {}
        self.syncing = True
        for key, w in self.fields.items():
            v = self.value(key)
            self.loaded[key] = v
            w.set_text(v)
        gloss = self.value("tab_gloss")
        self.loaded["tab_gloss"] = gloss
        self.gloss_off.set_active(gloss == "none")
        self.gloss_color.set_text(DEFAULTS["tab_gloss"] if gloss == "none" else gloss)
        bd = self.value("borders")
        self.loaded["borders"] = bd
        self.bd_none.set_active(bd == "none")
        self.bd_color.set_text(DEFAULTS["borders"] if bd == "none" else bd)
        left = self.value("left_line")
        self.loaded["left_line"] = left
        if left == "auto":
            self.left_auto.set_active(True)
        elif left == "none":
            self.left_none.set_active(True)
        else:
            self.left_custom.set_active(True)
            self.left_color.set_text(left)
        mb = self.value("menu_borders")
        self.loaded["menu_borders"] = mb
        self.mb_auto.set_active(mb == "auto")
        self.mb_color.set_text((self.value("menu_background") if bd == "none" else bd)
                               if mb == "auto" else mb)
        self.syncing = False
        self.update_sensitive()
        self.sync_theme()
        self.status.set_text("")

    def collect(self):
        vals = {key: w.get_text() for key, w in self.fields.items()}
        vals["tab_gloss"] = "none" if self.gloss_off.get_active() else self.gloss_color.get_text()
        vals["borders"] = "none" if self.bd_none.get_active() else self.bd_color.get_text()
        if self.left_auto.get_active():
            vals["left_line"] = "auto"
        elif self.left_none.get_active():
            vals["left_line"] = "none"
        else:
            vals["left_line"] = self.left_color.get_text()
        vals["menu_borders"] = "auto" if self.mb_auto.get_active() else self.mb_color.get_text()
        return vals

    def apply(self):
        self.rc.reload()   # build on any change made elsewhere
        changed = [k for k, v in self.collect().items() if v != self.loaded.get(k)]
        if not changed:
            self.status.set_text(_("Nothing changed"))
            return
        vals = self.collect()
        for k in changed:
            self.rc.set(k, vals[k])
        try:
            self.rc.save()
        except OSError as e:
            self.status.set_text(_("Cannot save: %s") % e)
            return
        for name in WM_NAMES + BAR_NAMES:
            subprocess.run(["pkill", "-HUP", "-x", name])
        self.load()
        self.status.set_text(gettext.ngettext("Saved %d setting; wm2tj has reloaded",
                                              "Saved %d settings; wm2tj has reloaded",
                                              len(changed)) % len(changed))


