#!/usr/bin/env python3
# wm2tj-favorites - edit the wm2tj favourites.
#
# Saved to ~/.config/wm2tj/favorites (shown in the menu top to bottom),
# one per line:
#   firefox.desktop          a .desktop id (icon and localized name from it)
#   "Notes" mousepad         "name" command (for things without a .desktop)
#   lines starting with # and empty lines are ignored
# wm2tj (the root menu) and wm2tj-bar (its menu) read the same file.
# Changes stay in the window until "Apply" (closing asks about them); the file
# is reread if changed elsewhere while nothing is pending.
# Until the file exists the list starts from wm2tj-bar's favourites, else the
# Whisker Menu's (what wm2-menu-gen puts in the menu); the first Apply writes it.
# On Apply wm2-menu-gen rebuilds ~/.wm2rc and wm2tj gets SIGHUP (it restarts
# in place, so only once per Apply), then this window is raised again.
# The list also shows wm2tj's built-in first entry (new_label / new_window in
# ~/.wm2rc, the terminal): it always stays at the top and is not in the file.
# Removing it writes "new_label none" on Apply (the label is kept in a comment),
# adding it back from the top of the applications puts the label back.
#
# Needs python3, PyGObject and GTK 3. Text domain "wm2tj".
import gettext, os, re, shlex, shutil, subprocess, sys
try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gtk, Gdk, Gio, GLib, Pango
except (ImportError, ValueError) as e:
    sys.exit(f"{sys.argv[0]}: needs PyGObject with GTK 3 (python3-gi, python-gobject, py3-gobject3): {e}")
try:
    gi.require_version("GioUnix", "2.0")
    from gi.repository import GioUnix
    DesktopAppInfo = GioUnix.DesktopAppInfo
except (ValueError, ImportError):
    DesktopAppInfo = Gio.DesktopAppInfo

TEXTDOMAIN = "wm2tj"
LOCALEDIR = "@LOCALEDIR@"	# filled in by make install
if LOCALEDIR.startswith("@"):
    LOCALEDIR = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])),
                             "..", "share", "locale")
gettext.bindtextdomain(TEXTDOMAIN, LOCALEDIR)
gettext.textdomain(TEXTDOMAIN)
_ = gettext.gettext

CONFIG_DIR = os.path.join(GLib.get_user_config_dir(), "wm2tj")
FAV_PATH = os.path.join(CONFIG_DIR, "favorites")
BAR_FAV_PATH = os.path.join(GLib.get_user_config_dir(), "wm2tj-bar", "favorites")
HEADER = ("# wm2tj favourites (edited with wm2tj-favorites; shown top to bottom)\n"
          "# format: foo.desktop  or  \"name\" command\n")
# wm2-menu-gen sits next to us when installed; else on $PATH. wm2 = old name.
MENU_GEN = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "wm2-menu-gen")
if not os.access(MENU_GEN, os.X_OK):
    MENU_GEN = shutil.which("wm2-menu-gen")
REGEN_CMD = '"$0" >/dev/null 2>&1; pkill -HUP -x "wm2tj|wm2"'
WM2RC = os.path.expanduser("~/.wm2rc")
MARKER = "# --- menu generated by wm2-menu-gen; edit above this line ---"
TERMINAL_ICON = "utilities-terminal"
RAISE_DELAY = 800       # ms after the SIGHUP: wm2tj has re-adopted the windows
ICON_SIZE = Gtk.IconSize.LARGE_TOOLBAR


class Fav:
    """One favourite: a desktop_id, or a (name, command) pair."""
    def __init__(self, desktop_id=None, name=None, command=None):
        self.desktop_id = desktop_id
        self.name = name
        self.command = command
        self.info = None
        if desktop_id:
            try:
                self.info = DesktopAppInfo.new(desktop_id)
            except TypeError:   # not found (uninstalled, ...)
                pass

    def label(self):
        if self.info:
            return self.info.get_display_name()
        if self.desktop_id:
            return _("%s (not found)") % self.desktop_id
        return self.name

    def icon(self):
        if self.info and self.info.get_icon():
            return self.info.get_icon()
        return Gio.ThemedIcon.new("application-x-executable")

    def tooltip(self):
        if self.info:
            return self.info.get_commandline() or self.desktop_id
        if self.desktop_id:
            return self.desktop_id
        return self.command

    def line(self):
        if self.desktop_id:
            return self.desktop_id
        return '"%s" %s' % (self.name.replace('"', "'"), self.command)


def parse_line(line):
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    if line.startswith('"'):
        end = line.find('"', 1)
        if end > 0 and line[end + 1:].strip():
            return Fav(name=line[1:end], command=line[end + 1:].strip())
        return None
    return Fav(desktop_id=line)


def rc_token(s):
    """One token of a ~/.wm2rc line as wm2tj reads it (a word or "quoted"),
    and the rest of the line."""
    s = s.strip()
    if s.startswith('"'):
        end = s.find('"', 1)
        return (s[1:end], s[end + 1:]) if end > 0 else (s[1:], "")
    m = re.match(r"(\S+)(.*)", s)
    return (m.group(1), m.group(2)) if m else ("", "")


class Terminal:
    """wm2tj's built-in first root-menu entry: new_label (its name; "none"
    hides it) runs new_window. Both are read above the wm2-menu-gen marker."""
    def __init__(self):
        self.label = "Terminal" # wm2tj's defaults (empty new_window: the user's terminal)
        self.command = ""
        self.saved = None       # the label kept in "new_label none  # ..."
        for line in self.read().partition(MARKER)[0].splitlines():
            key, rest = rc_token(line)
            if key == "new_label":
                self.label, rest = rc_token(rest)
                m = re.match(r"\s*#\s*(\S.*)", rest)
                self.saved = rc_token(m.group(1))[0] if m else None
            elif key == "new_window" and rest.strip() and not rest.strip().startswith("#"):
                self.command = re.split(r"\s#", rest.strip(), 1)[0].strip()

    @staticmethod
    def read():
        try:
            with open(WM2RC, encoding="utf-8") as f:
                return f.read()
        except FileNotFoundError:
            return ""

    def shown(self):
        return bool(self.label) and self.label != "none"

    def name(self):
        return self.label if self.shown() else (self.saved or _("Terminal"))

    def tooltip(self):
        return _("Built-in entry of wm2tj, always at the top (new_window in ~/.wm2rc): %s") % (
            self.command or _("the default terminal ($TERMINAL, x-terminal-emulator, …)"))

    def set_shown(self, on):
        """Rewrite the new_label line above the marker (the first one; any
        others are dropped, wm2tj would use the last)."""
        if on:
            new = 'new_label "%s"' % self.name().replace('"', "'")
        else:
            new = 'new_label none  # "%s"' % self.label.replace('"', "'")
        head, sep, tail = self.read().partition(MARKER)
        lines, done, after = [], False, None
        for line in head.splitlines():
            key = rc_token(line)[0]
            if key == "new_label":
                if not done:
                    lines.append(new)
                    done = True
                continue
            lines.append(line)
            if key == "new_window":
                after = len(lines)
        if not done:
            if after is None:
                while lines and not lines[-1].strip():
                    lines.pop()
                after = len(lines)
            lines.insert(after, new)
        head = "\n".join(lines).rstrip("\n") + "\n"
        if sep:
            head += "\n"
        tmp = WM2RC + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(head + sep + tail)
        os.replace(tmp, WM2RC)
        self.__init__()


def whisker_favorites():
    try:
        out = subprocess.run(["xfconf-query", "-c", "xfce4-panel", "-l", "-v"],
                             capture_output=True, text=True).stdout
        pid = next(l.split()[0] for l in out.splitlines()
                   if re.match(r"/plugins/plugin-\d+\s+whiskermenu$", l))
        out = subprocess.run(["xfconf-query", "-c", "xfce4-panel", "-p", pid + "/favorites"],
                             capture_output=True, text=True).stdout
        return [l.strip() for l in out.splitlines() if l.strip().endswith(".desktop")]
    except Exception:   # no xfconf-query, no Whisker Menu
        return []


def seed_text():
    """The favourites the menu shows while FAV_PATH is missing: wm2tj-bar's,
    else the Whisker Menu's (as wm2-menu-gen seeds them)."""
    try:
        with open(BAR_FAV_PATH, encoding="utf-8") as f:
            ids = [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        ids = []
    ids = ids or whisker_favorites()
    return HEADER + "".join(i + "\n" for i in ids) if ids else ""


def read_text():
    try:
        with open(FAV_PATH, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return seed_text()


def load_favorites(text):
    return [x for x in map(parse_line, text.splitlines()) if x]


def save_favorites(favs):
    text = HEADER + "".join(fav.line() + "\n" for fav in favs)
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = FAV_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, FAV_PATH)
    return text


def all_apps():
    apps = [a for a in Gio.AppInfo.get_all()
            if isinstance(a, DesktopAppInfo) and a.should_show()]
    apps.sort(key=lambda a: a.get_display_name().casefold())
    return apps


def make_row(icon, text, tooltip, dim=False):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    box.set_border_width(4)
    box.pack_start(Gtk.Image.new_from_gicon(icon, ICON_SIZE), False, False, 0)
    lab = Gtk.Label(label=text, xalign=0)
    lab.set_ellipsize(Pango.EllipsizeMode.END)
    box.pack_start(lab, True, True, 0)
    row = Gtk.ListBoxRow()
    row.add(box)
    row.label = lab
    row.set_tooltip_text(tooltip)
    if dim:
        row.set_sensitive(False)
    return row


class FavoritesWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Edit Favourites — wm2tj"))
        self.regen = None
        self.regen_again = False
        self.set_default_size(760, 520)
        self.set_border_width(10)
        self.connect("destroy", Gtk.main_quit)
        self.connect("delete-event", lambda *a: not self.confirm_close())
        self.connect("key-press-event", self.on_key)

        self.text = read_text()
        self.favs = load_favorites(self.text)
        self.term = Terminal()
        self.term_on = self.term.shown()    # pending until Apply
        self.saved = self.state()
        self.apps = all_apps()

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(outer)
        paned = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        outer.pack_start(paned, True, True, 0)

        # left: the favourites
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left.pack_start(self.heading(_("Favourites")), False, False, 0)
        self.fav_list = Gtk.ListBox()
        self.fav_list.connect("row-selected", lambda *a: self.update_buttons())
        left.pack_start(self.scrolled(self.fav_list), True, True, 0)
        btns = Gtk.Box(spacing=6)
        self.up_btn = self.button("go-up-symbolic", _("Move up"), lambda *a: self.move(-1))
        self.down_btn = self.button("go-down-symbolic", _("Move down"), lambda *a: self.move(1))
        for b in (self.up_btn, self.down_btn):
            btns.pack_start(b, False, False, 0)
        left.pack_start(btns, False, False, 0)
        paned.pack_start(left, True, True, 0)

        # middle: <- add / -> remove (a click in a list does neither)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      valign=Gtk.Align.CENTER)
        self.add_btn = self.button("go-previous-symbolic", _("Add to favourites"),
                                   lambda *a: self.add_selected())
        self.del_btn = self.button("go-next-symbolic", _("Remove from favourites"),
                                   lambda *a: self.remove_selected())
        mid.pack_start(self.add_btn, False, False, 0)
        mid.pack_start(self.del_btn, False, False, 0)
        paned.pack_start(mid, False, False, 0)

        # right: all applications
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.pack_start(self.heading(_("Applications")), False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text=_("Search"))
        self.search.connect("search-changed", lambda *a: self.app_list.invalidate_filter())
        right.pack_start(self.search, False, False, 0)
        self.app_list = Gtk.ListBox()
        self.app_list.set_filter_func(self.app_filter)
        self.app_list.connect("row-selected", lambda *a: self.update_buttons())
        right.pack_start(self.scrolled(self.app_list), True, True, 0)
        btns = Gtk.Box(spacing=6)
        cmd_btn = Gtk.Button(label=_("Add Command…"))
        cmd_btn.connect("clicked", lambda *a: self.add_command())
        btns.pack_start(cmd_btn, False, False, 0)
        right.pack_start(btns, False, False, 0)
        paned.pack_start(right, True, True, 0)

        # bottom: Revert / Apply, as in wm2tj-settings
        btns = Gtk.Box(spacing=6)
        self.revert_btn = Gtk.Button(label=_("Revert"))
        self.revert_btn.set_tooltip_text(_("Discard the changes not applied yet"))
        self.revert_btn.connect("clicked", lambda *a: self.revert())
        self.apply_btn = Gtk.Button(label=_("Apply"))
        self.apply_btn.get_style_context().add_class("suggested-action")
        self.apply_btn.set_tooltip_text(_("Save the favourites and update the wm2tj menu"))
        self.apply_btn.connect("clicked", lambda *a: self.apply())
        self.status = Gtk.Label(xalign=0)
        self.status.get_style_context().add_class("dim-label")
        btns.pack_start(self.revert_btn, False, False, 0)
        btns.pack_start(self.status, True, True, 0)
        btns.pack_end(self.apply_btn, False, False, 0)
        outer.pack_start(btns, False, False, 0)

        os.makedirs(CONFIG_DIR, exist_ok=True)   # needed to watch the file
        self.monitor = Gio.File.new_for_path(FAV_PATH).monitor_file(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.connect("changed", self.on_file_changed)

        self.build_app_list()
        self.refresh()
        self.search.grab_focus()

    def heading(self, text):
        lab = Gtk.Label(xalign=0)
        lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(text))
        return lab

    def scrolled(self, child):
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_shadow_type(Gtk.ShadowType.IN)
        sw.add(child)
        return sw

    def button(self, icon, tip, cb):
        b = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
        b.set_tooltip_text(tip)
        b.connect("clicked", cb)
        return b

    def fav_ids(self):
        return {f.desktop_id for f in self.favs if f.desktop_id}

    def term_rows(self):
        """1 while the built-in terminal entry is the first favourites row."""
        return 1 if self.term_on else 0

    def state(self):
        """What Apply would write: the favourites' lines and the terminal entry."""
        return ([fav.line() for fav in self.favs], self.term_on)

    def dirty(self):
        return self.state() != self.saved

    def build_app_list(self):
        """Once: the rows are updated in place afterwards (no rebuild, so no
        flicker and the scroll position stays)."""
        term_icon = Gio.ThemedIcon.new_with_default_fallbacks(TERMINAL_ICON)
        row = make_row(term_icon, "", self.term.tooltip())
        row.app = None
        self.app_list.add(row)
        for app in self.apps:
            row = make_row(app.get_icon() or Gio.ThemedIcon.new("application-x-executable"),
                           "", app.get_description() or app.get_id())
            row.app = app
            self.app_list.add(row)
        self.app_list.show_all()

    def update_app_marks(self):
        """✓ and greyed out for the applications already in the favourites."""
        ids = self.fav_ids()
        for row in self.app_list.get_children():
            if row.app is None:
                on, text = self.term_on, self.term.name() + " (wm2tj)"
            else:
                on, text = row.app.get_id() in ids, row.app.get_display_name()
            row.label.set_text(text + (" ✓" if on else ""))
            row.set_sensitive(not on)

    def refresh(self, select=None):
        """Rebuild the (short) favourites list; select: an index into
        self.favs, or "terminal"."""
        for child in self.fav_list.get_children():
            self.fav_list.remove(child)
        if self.term_on:
            term_icon = Gio.ThemedIcon.new_with_default_fallbacks(TERMINAL_ICON)
            self.fav_list.add(make_row(term_icon, self.term.name(), self.term.tooltip()))
        for fav in self.favs:
            self.fav_list.add(make_row(fav.icon(), fav.label(), fav.tooltip()))
        self.fav_list.show_all()
        self.update_app_marks()
        row = None
        if select == "terminal" and self.term_on:
            row = self.fav_list.get_row_at_index(0)
        elif isinstance(select, int) and 0 <= select < len(self.favs):
            row = self.fav_list.get_row_at_index(select + self.term_rows())
        if row:
            self.fav_list.select_row(row)
        self.update_buttons()

    def app_filter(self, row):
        q = self.search.get_text().strip().casefold()
        if not q:
            return True
        app = row.app
        if app is None:   # the built-in terminal entry
            return q in " ".join([self.term.name(), "wm2tj terminal",
                                  _("Terminal"), self.term.command]).casefold()
        # through the class: PyGObject 3.48 with GioUnix (GLib 2.80) binds
        # app.get_generic_name() / app.get_keywords() without self (TypeError)
        hay = " ".join(filter(None, [app.get_display_name(), app.get_name(),
                                     DesktopAppInfo.get_generic_name(app), app.get_id(),
                                     " ".join(DesktopAppInfo.get_keywords(app) or [])]))
        return q in hay.casefold()

    def selected_fav(self):
        """The index into self.favs; -1 for none or the terminal entry."""
        row = self.fav_list.get_selected_row()
        return row.get_index() - self.term_rows() if row else -1

    def terminal_selected(self):
        row = self.fav_list.get_selected_row()
        return bool(row and self.term_on and row.get_index() == 0)

    def update_buttons(self):
        i = self.selected_fav()
        self.up_btn.set_sensitive(i > 0)
        self.down_btn.set_sensitive(0 <= i < len(self.favs) - 1)
        self.del_btn.set_sensitive(i >= 0 or self.terminal_selected())
        row = self.app_list.get_selected_row()
        self.add_btn.set_sensitive(bool(row and row.get_sensitive()))
        dirty = self.dirty()
        self.apply_btn.set_sensitive(dirty)
        self.revert_btn.set_sensitive(dirty)
        if dirty:
            self.status.set_text(_("Not applied yet"))
        elif self.status.get_text() == _("Not applied yet"):
            self.status.set_text("")

    def commit(self, select=None):
        """A change in the window only; Apply saves it."""
        self.refresh(select)

    def apply(self):
        if not self.dirty():
            self.status.set_text(_("Nothing changed"))
            return
        lines, term_on = self.state()
        try:
            if term_on != self.term.shown():
                # after any running wm2-menu-gen, which would put the old head back
                if self.regen and self.regen.poll() is None:
                    self.regen.wait()
                self.term.set_shown(term_on)
            if lines != self.saved[0] or not os.path.exists(FAV_PATH):
                self.text = save_favorites(self.favs)
        except OSError as e:
            self.error(str(e))
            return
        term_changed = term_on != self.saved[1]
        self.saved = self.state()
        if MENU_GEN:
            self.regen_menu()
        elif term_changed:  # the favourites are not in the root menu then
            subprocess.Popen(["pkill", "-HUP", "-x", "wm2tj|wm2"])
            GLib.timeout_add(RAISE_DELAY, self.raise_again)
        self.status.set_text(_("Applied"))
        self.update_buttons()

    def revert(self):
        self.text = read_text()
        self.favs = load_favorites(self.text)
        self.term = Terminal()
        self.term_on = self.term.shown()
        self.saved = self.state()
        self.status.set_text("")
        self.refresh()

    def raise_again(self):
        """wm2tj restarted (SIGHUP) and re-adopted the windows, maybe with
        this one under the others: bring it back to the front."""
        self.present_with_time(Gdk.CURRENT_TIME)
        return False

    def error(self, text):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.ERROR,
                                buttons=Gtk.ButtonsType.CLOSE, text=text)
        dlg.run()
        dlg.destroy()

    def confirm_close(self):
        """True when the window may close (changes applied or discarded)."""
        if not self.dirty():
            return True
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.QUESTION,
                                text=_("Apply the changes before closing?"))
        dlg.add_buttons(_("Discard"), Gtk.ResponseType.NO,
                        _("Cancel"), Gtk.ResponseType.CANCEL,
                        _("Apply"), Gtk.ResponseType.YES)
        dlg.set_default_response(Gtk.ResponseType.YES)
        r = dlg.run()
        dlg.destroy()
        if r == Gtk.ResponseType.YES:
            self.apply()
            return not self.dirty()
        return r == Gtk.ResponseType.NO

    def regen_menu(self):
        """Rebuild the wm2tj root menu, one run at a time (another after it
        if changes came while it ran)."""
        if not MENU_GEN:
            return
        if self.regen and self.regen.poll() is None:
            self.regen_again = True
            return
        self.regen_again = False
        self.regen = subprocess.Popen(["sh", "-c", REGEN_CMD, MENU_GEN])
        GLib.timeout_add(300, self.regen_poll)

    def set_terminal(self, on):
        """Show or hide the built-in terminal entry (written on Apply)."""
        self.term_on = on
        self.refresh("terminal" if on else (0 if self.favs else None))

    def regen_poll(self):
        if self.regen.poll() is None:
            return True
        if self.regen_again:
            self.regen_menu()
        else:
            GLib.timeout_add(RAISE_DELAY, self.raise_again)
        return False

    def add_selected(self):
        row = self.app_list.get_selected_row()
        if not row or not row.get_sensitive():
            return
        if row.app is None:
            self.set_terminal(True)
            return
        self.favs.append(Fav(desktop_id=row.app.get_id()))
        self.commit(len(self.favs) - 1)

    def remove_selected(self):
        if self.terminal_selected():
            self.set_terminal(False)
            return
        i = self.selected_fav()
        if i < 0:
            return
        del self.favs[i]
        self.commit(min(i, len(self.favs) - 1))

    def move(self, d):
        i = self.selected_fav()
        j = i + d
        if i < 0 or not 0 <= j < len(self.favs):
            return
        self.favs[i], self.favs[j] = self.favs[j], self.favs[i]
        self.commit(j)

    def add_command(self):
        dlg = Gtk.Dialog(title=_("Add Command"), transient_for=self, modal=True)
        dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL,
                        _("Add"), Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=6, column_spacing=8, border_width=10)
        name = Gtk.Entry(activates_default=True, hexpand=True)
        cmd = Gtk.Entry(activates_default=True, hexpand=True)
        cmd.set_placeholder_text(_("e.g. mousepad ~/notes.txt"))
        grid.attach(Gtk.Label(label=_("Name"), xalign=1), 0, 0, 1, 1)
        grid.attach(name, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label=_("Command"), xalign=1), 0, 1, 1, 1)
        grid.attach(cmd, 1, 1, 1, 1)
        dlg.get_content_area().add(grid)
        dlg.set_default_size(420, -1)
        dlg.show_all()
        while dlg.run() == Gtk.ResponseType.OK:
            n, c = name.get_text().strip(), cmd.get_text().strip()
            try:
                ok = bool(n and c and shlex.split(c))
            except ValueError:
                ok = False
            if ok:
                self.favs.append(Fav(name=n, command=c))
                self.commit(len(self.favs) - 1)
                break
        dlg.destroy()

    def on_file_changed(self, *args):
        text = read_text()
        if text == self.text:   # our own write
            return
        self.text = text
        if self.dirty():        # keep the pending changes; Apply overwrites
            return
        self.favs = load_favorites(text)
        self.saved = self.state()
        self.refresh()

    def on_key(self, w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            if self.confirm_close():
                self.destroy()
            return True
        if ev.keyval == Gdk.KEY_Delete and self.fav_list.get_focus_child():
            self.remove_selected()
            return True
        return False


if __name__ == "__main__":
    FavoritesWindow().show_all()
    Gtk.main()
