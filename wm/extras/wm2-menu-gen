#!/usr/bin/env python3
"""Generate the ~/.wm2rc menu to match the panel's Whisker Menu.

- Favourites first (same order), as top-level entries: ~/.config/wm2tj/favorites
  (edited with wm2tj-favorites; "foo.desktop" or '"Name" command' lines).
  If that file does not exist yet it is created from wm2tj-bar's own
  favourites (~/.config/wm2tj-bar/favorites), else from the Whisker Menu's,
  so the bar (sync_wm2tj) and this menu share one list from the first run.
- Then one submenu per category of the Xubuntu applications menu
  (xfce-applications.menu, freedesktop menu-spec subset), named and
  sorted like Whisker does (localized names, alphabetical).
- Everything above the marker line in ~/.wm2rc is kept.

The menu's own labels are English, translated with gettext (text domain
"wm2tj", po/ in this directory); application names come from the .desktop
files in the user's language.
"""
import os, re, sys, shutil, subprocess, configparser, gettext
import xml.etree.ElementTree as ET
from pathlib import Path

TEXTDOMAIN = "wm2tj"
LOCALEDIR = "@LOCALEDIR@"	# filled in by make install
if LOCALEDIR.startswith("@"):
    LOCALEDIR = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])),
                             "..", "share", "locale")
gettext.bindtextdomain(TEXTDOMAIN, LOCALEDIR)
gettext.textdomain(TEXTDOMAIN)
_ = gettext.gettext
N_ = lambda s: s
# wm2rc.sample: the settings part of a fresh ~/.wm2rc (installed by make
# install; when run from the source tree it is next to this script)
SAMPLE = "@DATADIR@/wm2tj/wm2rc.sample"	# filled in by make install
if SAMPLE.startswith("@"):
    SAMPLE = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "wm2rc.sample")

HOME = Path.home()
MARKER = "# --- menu generated by wm2-menu-gen; edit above this line ---"
# The XDG dirs of the session (wm2-session adds the Xfce/Xubuntu, Flatpak and
# snap ones), so the menu matches what the desktop shows; nothing hardcoded
# for one distribution.
def env_dirs(var, default):
    return [d for d in (os.environ.get(var) or default).split(":") if d]


CONFIG_DIRS = env_dirs("XDG_CONFIG_DIRS", "/etc/xdg")
DATA_DIRS = [os.environ.get("XDG_DATA_HOME") or str(HOME / ".local/share")] \
    + env_dirs("XDG_DATA_DIRS", "/usr/local/share:/usr/share") \
    + [str(HOME / ".local/share/flatpak/exports/share"), "/var/lib/flatpak/exports/share",
       "/var/lib/snapd/desktop"]
DATA_DIRS = list(dict.fromkeys(d for d in DATA_DIRS if Path(d).is_dir()))
# OnlyShowIn / NotShowIn are matched against the session's desktop names plus
# XFCE: wm2tj runs the Xfce settings daemon, so its settings tools belong in
# the menu whatever the login manager called the session.
DESKTOPS = {d for d in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":") if d} | {"wm2tj", "XFCE"}


def locale_langs():
    """Locale names for Name[xx] keys, most preferred first (as gettext/GLib)."""
    for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var):
            break
    else:
        return []
    out = []
    for loc in os.environ[var].split(":"):
        loc, mod = (loc.split("@", 1) + [""])[:2]   # lang_COUNTRY.ENCODING@MODIFIER
        loc = loc.split(".")[0]
        if loc in ("", "C", "POSIX"):
            continue
        lang = loc.split("_")[0]
        for l in ([loc + "@" + mod] if mod else []) + [loc] + ([lang + "@" + mod] if mod else []) + [lang]:
            if l not in out:
                out.append(l)
    return out


LANGS = locale_langs()
FAVORITES = HOME / ".config/wm2tj/favorites"
BAR_FAVORITES = HOME / ".config/wm2tj-bar/favorites"
FAV_HEADER = ("# wm2tj favourites (edited with wm2tj-favorites; shown top to bottom)\n"
              "# format: foo.desktop  or  \"name\" command\n")
# xfce4-panel is replaced by wm2tj-bar; its preferences would start the panel
EXCLUDE = {"panel-preferences.desktop", "panel-desktop-handler.desktop"}
# xfce4-terminal is not installed on this machine
# Terminal=true entries: $TERMINAL, else the first terminal found
for _t, _flag in ([(os.environ["TERMINAL"], "-e")] if os.environ.get("TERMINAL") else []) + [
        ("xfce4-terminal", "-x"), ("x-terminal-emulator", "-e"), ("gnome-terminal", "--"),
        ("konsole", "-e"), ("mate-terminal", "-x"), ("lxterminal", "-e"), ("qterminal", "-e"),
        ("alacritty", "-e"), ("kitty", "--"), ("tilix", "-e"), ("urxvt", "-e"), ("xterm", "-e")]:
    if shutil.which(_t):
        TERM_EXEC = f"{_t} {_flag} "
        break
else:
    TERM_EXEC = "xterm -e "


def tool(name):
    """Our helper scripts: on $PATH, else ~/.local/bin (the unit may lack it)."""
    return shutil.which(name) or str(HOME / ".local/bin" / name)


FAV_EDITOR = tool("wm2tj-favorites")
WALLPAPER = tool("wm2-wallpaper")
# wm2tj's own tools (settings GUIs) go in one submenu after the favourites
SETTINGS = tool("wm2tj-settings")
WM2TJ_MENU = [f'    menu "{_("Settings…")}" {SETTINGS}',
              f'    menu "{_("Edit Favourites…")}" {FAV_EDITOR}']
if os.access(WALLPAPER, os.X_OK):
    WM2TJ_MENU.append(f'    menu "{_("Change Wallpaper…")}" {WALLPAPER} --choose')
LOGOUT_CMD = tool("session-logout")
RESTART = f'menu "{_("Restart wm2tj (reload settings)")}" pkill -HUP -x wm2tj'
LOGOUT = f'menu "{_("Log Out")}" {LOGOUT_CMD}'
# Power entries ask first (session-logout --ask), so a stray click is harmless.
POWER = [f'menu "{_("Restart")}" {LOGOUT_CMD} --ask --reboot',
         f'menu "{_("Shut Down")}" {LOGOUT_CMD} --ask --halt']


def read_entry(path, group):
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    try:
        cp.read(path, encoding="utf-8")
        return cp[group]
    except Exception:
        return None


def loc(e, key):
    for l in LANGS:
        if e.get(f"{key}[{l}]"):
            return e.get(f"{key}[{l}]")
    # Ubuntu/GNOME entries keep translations in .mo files (as GLib/Whisker do)
    dom = e.get("X-Ubuntu-Gettext-Domain") or e.get("X-GNOME-Gettext-Domain")
    if dom and e.get(key):
        try:
            return gettext.translation(dom).gettext(e.get(key))
        except OSError:
            pass
    return e.get(key, "")


def load_apps():
    apps = {}
    for d in DATA_DIRS:
        ad = Path(d) / "applications"
        if not ad.is_dir():
            continue
        for f in sorted(ad.rglob("*.desktop")):
            fid = str(f.relative_to(ad)).replace("/", "-")
            if fid in apps or fid in EXCLUDE:
                continue
            e = read_entry(f, "Desktop Entry")
            apps[fid] = None
            if e is None or e.get("Type") != "Application":
                continue
            if e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
                continue
            only = [x for x in e.get("OnlyShowIn", "").split(";") if x]
            if only and not DESKTOPS & set(only):
                continue
            if DESKTOPS & {x for x in e.get("NotShowIn", "").split(";") if x}:
                continue
            te = e.get("TryExec")
            if te and not (shutil.which(te) or os.access(te, os.X_OK)):
                continue
            ex = e.get("Exec")
            if not ex:
                continue
            ex = re.sub(r"%[fFuUdDnNickvm]", "", ex).replace("%%", "%").strip()
            if e.get("Terminal") == "true":
                ex = TERM_EXEC + ex
            apps[fid] = {"name": loc(e, "Name"), "exec": ex,
                         "cats": set(x for x in e.get("Categories", "").split(";") if x)}
    return {k: v for k, v in apps.items() if v}


def match(rule, fid, app):
    tag = rule.tag
    if tag == "Category":
        return (rule.text or "").strip() in app["cats"]
    if tag == "Filename":
        return (rule.text or "").strip() == fid
    if tag == "All":
        return True
    if tag == "Or":
        return any(match(r, fid, app) for r in rule)
    if tag == "And":
        return all(match(r, fid, app) for r in rule)
    if tag == "Not":
        return not any(match(r, fid, app) for r in rule)
    return False


def selected(menu, fid, app):
    inc = any(match(r, fid, app) for i in menu.findall("Include") for r in i)
    exc = any(match(r, fid, app) for x in menu.findall("Exclude") for r in x)
    return inc and not exc


def directory_name(menu):
    d = menu.findtext("Directory")
    if d:
        for dd in DATA_DIRS:
            p = Path(dd) / "desktop-directories" / d.strip()
            if p.exists():
                e = read_entry(p, "Desktop Entry")
                if e is not None:
                    return loc(e, "Name")
    return menu.findtext("Name")


# Without Xfce's menu file (any non-Xfce distribution): the menu-spec main
# categories, named like the Xfce directories. Order = the menu order.
BUILTIN_CATEGORIES = [
    (N_("Accessories"), "Utility"), (N_("Development"), "Development"),
    (N_("Education"), "Education"), (N_("Games"), "Game"), (N_("Graphics"), "Graphics"),
    (N_("Internet"), "Network"), (N_("Multimedia"), "AudioVideo"), (N_("Office"), "Office"),
    (N_("Science"), "Science"), (N_("Settings"), "Settings"), (N_("System"), "System"),
]


def builtin_categories(apps):
    cats, allocated = [], set()
    for name, cat in BUILTIN_CATEGORIES:
        ids = {f for f, a in apps.items() if cat in a["cats"]} - allocated
        allocated |= ids
        cats.append((_(name), ids))
    cats.append((_("Other"), set(apps) - allocated))
    return sorted(((n, ids) for n, ids in cats if ids), key=lambda c: c[0])


def categories(apps):
    """Categories as the Xfce menu file (garcon) defines them; this parser
    follows that file's structure, other desktops' .menu files use MergeDir
    and Move, so without xfce-applications.menu use the built-in table."""
    menu_file = next((Path(c) / "menus/xfce-applications.menu" for c in CONFIG_DIRS
                      if (Path(c) / "menus/xfce-applications.menu").exists()), None)
    if menu_file is None:
        return builtin_categories(apps)
    root = ET.parse(menu_file).getroot()
    cats, allocated, pending = [], set(), []

    def collect(menu):  # Whisker flattens nested submenus into their category
        ids = {f for f, a in apps.items() if selected(menu, f, a)}
        for sub in menu.findall("Menu"):
            ids |= collect(sub)
        return ids

    for m in root.findall("Menu"):
        if m.find("OnlyUnallocated") is not None:
            pending.append(m)
            continue
        ids = collect(m)
        allocated |= ids
        cats.append((directory_name(m), ids))
    for m in pending:
        cats.append((directory_name(m), {f for f in collect(m) if f not in allocated}))
    return sorted(((n, ids) for n, ids in cats if ids), key=lambda c: c[0])


def whisker_favorites():
    try:
        out = subprocess.run(["xfconf-query", "-c", "xfce4-panel", "-l", "-v"],
                             capture_output=True, text=True).stdout
        pid = next(l.split()[0] for l in out.splitlines()
                   if re.match(r"/plugins/plugin-\d+\s+whiskermenu$", l))
        out = subprocess.run(["xfconf-query", "-c", "xfce4-panel", "-p", pid + "/favorites"],
                             capture_output=True, text=True).stdout
        return [l.strip() for l in out.splitlines() if l.strip().endswith(".desktop")]
    except Exception:
        return []


def seed_favorites():
    """Create ~/.config/wm2tj/favorites from wm2tj-bar's favourites or the
    Whisker Menu's. Returns False if there was nothing to start from."""
    try:
        ids = [l.strip() for l in BAR_FAVORITES.read_text(encoding="utf-8").splitlines()
               if l.strip() and not l.startswith("#")]
    except OSError:
        ids = []
    ids = ids or whisker_favorites()
    if not ids:
        return False
    FAVORITES.parent.mkdir(parents=True, exist_ok=True)
    tmp = FAVORITES.with_name("favorites.tmp")
    tmp.write_text(FAV_HEADER + "".join(i + "\n" for i in ids), encoding="utf-8")
    tmp.replace(FAVORITES)
    return True


def favorite_lines(apps):
    """Menu lines for the favourites, or None if the wm2tj file is missing."""
    try:
        lines = FAVORITES.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return None
    out = []
    for l in (l.strip() for l in lines):
        if not l or l.startswith("#"):
            continue
        m = re.match(r'"([^"]*)"\s+(.+)', l)
        if m:
            out.append(f'menu "{q(m.group(1))}" {m.group(2)}')
        elif l in apps:
            out.append(f'menu "{q(apps[l]["name"])}" {apps[l]["exec"]}')
    return out


def q(s):
    return s.replace('"', "")


def main():
    apps = load_apps()
    out = [MARKER]
    favs = favorite_lines(apps)
    if favs is None and seed_favorites():
        favs = favorite_lines(apps)
    if favs is None:
        favs = []
    out += favs
    out += ['submenu "wm2tj" {', *WM2TJ_MENU, "}"]
    n = 0
    for name, ids in categories(apps):
        out.append(f'submenu "{q(name)}" {{')
        for a in sorted((apps[i] for i in ids), key=lambda a: a["name"].casefold()):
            out.append(f'    menu "{q(a["name"])}" {a["exec"]}')
            n += 1
        out.append("}")
    out.append(RESTART)
    out.append(LOGOUT)
    out += POWER

    rc = HOME / ".wm2rc"
    if rc.exists():
        head = rc.read_text(encoding="utf-8").split(MARKER)[0]
    else:
        # first run: start from the sample so that the settings (desktops,
        # tab size, "▶ " on the folders, ...) are there and not the bare
        # built-in defaults; its "Terminal" label in the user's language
        head = sample_settings()
    head = "\n".join(l for l in head.splitlines() if l.strip() not in (RESTART, LOGOUT, *POWER)).rstrip() + "\n\n"
    rc.write_text(head + "\n".join(out) + "\n", encoding="utf-8")
    print(f"{rc}: favorites + {n} entries")


def sample_settings():
    try:
        text = Path(SAMPLE).read_text(encoding="utf-8")
    except OSError:
        return ""
    label = _("Terminal")
    if label != "Terminal":
        text = re.sub(r'^new_label "Terminal"', f'new_label "{q(label)}"', text, count=1, flags=re.M)
    return text


if __name__ == "__main__":
    main()
