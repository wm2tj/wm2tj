    # values
    def default_for(self, key, rc):
        if key in FROM_WM2RC and FROM_WM2RC[key] in rc:
            return rc[FROM_WM2RC[key]]
        if key == "height":		# as the bar works it out, roughly
            try:
                tw = int(rc.get("tab_width", "32"))
            except ValueError:
                tw = 32
            _f, _s, size, unit = parse_xft(rc.get("font", DEFAULTS["font"]))
            px = size if unit == "px" else size * 96 / 72
            return str(max(tw, round(px * 1.45) + 4) + 2)
        if key == "tab_label":
            return socket.gethostname()
        if key == "tab_length":
            return "0"
        return DEFAULTS.get(key, "")

    def load(self):
        self.conf.reload()
        rc = wm2rc_values()
        self.loaded = {}
        for s in self.settings:
            v = self.conf.get(s.key)
            s.load(v, self.default_for(s.key, rc))
            self.loaded[s.key] = s.state()
        self.status.set_text(CONFIG)

    def apply(self):
        self.conf.reload()		# build on what is in the file now
        changed = [s for s in self.settings if s.state() != self.loaded[s.key]]
        if not changed:
            # reload anyway: the "Same as wm2tj" values come from ~/.wm2rc,
            # which may have changed since the bar started
            if subprocess.run(["pkill", "-HUP", "-x", PROGNAME]).returncode == 0:
                self.status.set_text(_("No changes; the bar has reloaded"))
            else:
                self.status.set_text(_("No changes"))
            return
        for s in changed:
            v = s.state()
            if v is None:
                self.conf.unset(s.key)
            else:
                self.conf.set(s.key, v)
        try:
            self.conf.save()
        except OSError as e:
            self.status.set_text(_("Cannot save: %s") % e)
            return
        running = subprocess.run(["pkill", "-HUP", "-x", PROGNAME]).returncode == 0
        if any(s.key == "sync_wm2tj" and s.state() == "yes" for s in changed):
            regen_wm2tj_menu()
        n = len(changed)
        self.load()
        if running:
            self.status.set_text(gettext.ngettext("Saved %d setting; the bar has reloaded",
                                                  "Saved %d settings; the bar has reloaded", n) % n)
        else:
            self.status.set_text(gettext.ngettext("Saved %d setting",
                                                  "Saved %d settings", n) % n)


def regen_wm2tj_menu():
    """Sync just switched on: have wm2tj's menu take the shared favourites
    (wm2-menu-gen starts ~/.config/wm2tj/favorites from ours if it is missing)."""
    gen = shutil.which("wm2-menu-gen")
    for d in (os.path.expanduser("~/.local/bin"), "/usr/local/bin"):
        if gen:
            break
        if os.access(os.path.join(d, "wm2-menu-gen"), os.X_OK):
            gen = os.path.join(d, "wm2-menu-gen")
    if gen:
        # --hup: SIGHUP only to a wm2tj that does not reread the menu itself
        subprocess.Popen(["sh", "-c", '"$0" --hup >/dev/null 2>&1', gen])


