# ---- the config file ------------------------------------------------

def split_line(line):
    """(key, value, value start, value end) as the bar reads it, or None."""
    m = re.match(r"\s*([^\s#]\S*)", line)
    if not m:
        return None
    rest = line[m.end():]
    i = len(rest) - len(rest.lstrip())
    if i < len(rest) and rest[i] == '"':
        j = rest.find('"', i + 1)
        if j < 0:
            j = len(rest.rstrip("\n"))
            return m.group(1), rest[i + 1:j], m.end() + i, m.end() + j
        return m.group(1), rest[i + 1:j], m.end() + i, m.end() + j + 1
    v = rest[i:].split("#", 1)[0].rstrip()
    return m.group(1), v, m.end() + i, m.end() + i + len(v)


def quote(v):
    v = v.replace('"', "")
    if v == "" or re.search(r"[\s#]", v):
        return '"%s"' % v
    return v


class ConfigFile:
    def __init__(self, path):
        self.path = path
        self.reload()

    def reload(self):
        try:
            with open(self.path, encoding="utf-8") as f:
                self.lines = f.read().splitlines(keepends=True)
        except FileNotFoundError:
            self.lines = []

    def entries(self):
        for n, line in enumerate(self.lines):
            e = split_line(line)
            if e:
                yield (n,) + e

    def get(self, key):
        val = None
        for _n, k, v, _s, _e in self.entries():
            if k == key:
                val = v		# the last one wins, as in the bar
        return val

    def set(self, key, value):
        last = None
        for n, k, _v, s, e in self.entries():
            if k == key:
                last = (n, s, e)
        if last:
            n, s, e = last
            line = self.lines[n]
            self.lines[n] = line[:s] + quote(value) + line[e:]
            return
        if self.lines and not self.lines[-1].endswith("\n"):
            self.lines[-1] += "\n"
        self.lines.append("%-15s %s\n" % (key, quote(value)))

    def unset(self, key):
        for n, k, _v, _s, _e in list(self.entries()):
            if k == key:
                self.lines[n] = "# " + self.lines[n]

    def save(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        if os.path.exists(self.path) and not os.path.exists(BACKUP):
            shutil.copy2(self.path, BACKUP)
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("".join(self.lines))
        os.replace(tmp, self.path)


def wm2rc_values():
    vals = {}
    try:
        with open(WM2RC, encoding="utf-8") as f:
            for line in f:
                e = split_line(line)
                if e:
                    vals[e[0]] = e[1]
    except OSError:
        pass
    return vals


# ---- colours --------------------------------------------------------

_X_COLOURS = None


def x_colours():
    global _X_COLOURS
    if _X_COLOURS is None:
        _X_COLOURS = {}
        for p in ("/usr/share/X11/rgb.txt", "/etc/X11/rgb.txt"):
            try:
                with open(p) as f:
                    for line in f:
                        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\d+)\s+(.+?)\s*$", line)
                        if m:
                            name = m.group(4).lower().replace(" ", "")
                            _X_COLOURS[name] = tuple(int(m.group(i)) for i in (1, 2, 3))
                break
            except OSError:
                pass
    return _X_COLOURS


def to_rgba(text):
    rgba = Gdk.RGBA()
    rgb = x_colours().get(text.lower().replace(" ", "")) if text else None
    if rgb:
        rgba.red, rgba.green, rgba.blue = (c / 255 for c in rgb)
        rgba.alpha = 1
    elif not (text and rgba.parse(text)):
        rgba.parse("gray")
    return rgba


def to_hex(rgba):
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in (rgba.red, rgba.green, rgba.blue))


# ---- fonts (Xft names <-> the font chooser) ------------------------

def parse_xft(name):
    """'Family:style=Bold:pixelsize=12' / 'Family-10' -> (family, style, size, unit)"""
    parts = name.split(":")
    head, props = parts[0], parts[1:]
    size, unit = None, "pt"
    m = re.match(r"(.*?)-(\d+(?:\.\d+)?)$", head)
    if m:
        head, size = m.group(1), float(m.group(2))
    style = ""
    for p in props:
        k, _sep, v = p.partition("=")
        if k == "style":
            style = v
        elif k == "pixelsize":
            size, unit = float(v), "px"
        elif k == "size":
            size, unit = float(v), "pt"
    return head.strip(), style, size or 10, unit


def make_xft(family, style, size, unit):
    s = family
    if style and style.lower() not in ("regular", "normal", "book"):
        s += ":style=" + style
    n = int(size) if size == int(size) else size
    s += (":pixelsize=%s" if unit == "px" else ":size=%s") % n
    return s


# ---- fields: each shows a value as text and gives it back ----------

class TextField(Gtk.Entry):
    def __init__(self, width=24, tip=None):
        super().__init__(width_chars=width)
        if tip:
            self.set_tooltip_text(tip)

    def set_text(self, text):
        super().set_text(text)

    def get_value(self):
        return self.get_text()


class NumberField(Gtk.Box):
    def __init__(self, lo, hi, unit="", tip=None):
        super().__init__(spacing=6)
        self.spin = Gtk.SpinButton.new_with_range(lo, hi, 1)
        self.pack_start(self.spin, False, False, 0)
        if unit:
            self.pack_start(Gtk.Label(label=unit), False, False, 0)
        if tip:
            self.set_tooltip_text(tip)

    def set_text(self, text):
        try:
            self.spin.set_value(int(text))
        except ValueError:
            self.spin.set_value(0)

    def get_value(self):
        return str(self.spin.get_value_as_int())


class ChoiceField(Gtk.ComboBoxText):
    def __init__(self, choices):
        super().__init__()
        for value, label in choices:
            self.append("=" + value, label)	# "=": ids may not be empty

    def set_text(self, text):
        if not self.set_active_id("=" + text):
            self.append("=" + text, text)
            self.set_active_id("=" + text)

    def get_value(self):
        return (self.get_active_id() or "=")[1:]


class ColourField(Gtk.Box):
    """A colour button and the value as written (white / #2a7de1 ...).
    Left alone, the value keeps the way it was written."""
    def __init__(self):
        super().__init__(spacing=8)
        self.button = Gtk.ColorButton()
        self.label = Gtk.Label(xalign=0)
        self.label.get_style_context().add_class("dim-label")
        self.button.connect("color-set", self.on_set)
        self.pack_start(self.button, False, False, 0)
        self.pack_start(self.label, False, False, 0)

    def set_text(self, text):
        self.text = text
        self.button.set_rgba(to_rgba(text))
        self.label.set_text(text)

    def on_set(self, *a):
        self.text = to_hex(self.button.get_rgba())
        self.label.set_text(self.text)

    def get_value(self):
        return self.text


class GlossField(Gtk.Box):
    """gloss: a colour, or none for a flat tab."""
    def __init__(self):
