class FontField(Gtk.Box):
    """Family and style from the font chooser, the size in the unit it was written in."""
    def __init__(self):
        super().__init__(spacing=8)
        self.button = Gtk.FontButton()
        self.button.set_level(Gtk.FontChooserLevel.FAMILY | Gtk.FontChooserLevel.STYLE)
        self.button.set_use_font(True)
        self.size = Gtk.SpinButton.new_with_range(5, 72, 1)
        self.unit = Gtk.Label()
        self.pack_start(self.button, True, True, 0)
        self.pack_start(self.size, False, False, 0)
        self.pack_start(self.unit, False, False, 0)

    def set_text(self, text):
        self.original = text
        family, style, size, self.u = parse_xft(text)
        self.button.set_font("%s %s %d" % (family, style, size))
        self.size.set_value(size)
        self.unit.set_text(self.u)
        self.start = (family, style, size)

    def get_value(self):
        fam = self.button.get_font_family()
        face = self.button.get_font_face()
        family = fam.get_name() if fam else self.start[0]
        style = face.get_face_name() if face else self.start[1]
        new = make_xft(family, style, self.size.get_value(), self.u)
        if new == make_xft(*self.start, self.u):	# untouched: as it was written
            return self.original
        return new


class ClockField(Gtk.Box):
    """strftime format, with a few ready ones and a preview."""
    FORMATS = ["%H:%M", "%H:%M:%S", "%m/%d %H:%M", "%m/%d(%a) %H:%M",
               "%a %d %b %H:%M", "%Y-%m-%d %H:%M", "%I:%M %p"]

    def __init__(self):
        super().__init__(spacing=12)
        self.combo = Gtk.ComboBoxText.new_with_entry()
        for f in self.FORMATS:
            self.combo.append_text(f)
        self.preview = Gtk.Label(xalign=0)
        self.preview.get_style_context().add_class("dim-label")
        self.combo.connect("changed", lambda *a: self.update())
        self.combo.set_tooltip_text(_("strftime format, see man strftime"))
        self.pack_start(self.combo, False, False, 0)
        self.pack_start(self.preview, False, False, 0)

    def update(self):
        try:
            self.preview.set_text(time.strftime(self.get_value()))
        except ValueError:
            self.preview.set_text("")

    def set_text(self, text):
        self.combo.get_child().set_text(text)
        self.update()

    def get_value(self):
        return self.combo.get_child().get_text()


class TrayHideField(Gtk.Box):
    """tray_hide: ticks for the usual duplicates, the rest as text."""
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.ticks = []
        for name, label in KNOWN_TRAY:
            t = Gtk.CheckButton(label="%s  (%s)" % (_(label), name))
            self.ticks.append((name, t))
            self.pack_start(t, False, False, 0)
        row = Gtk.Box(spacing=8)
        row.pack_start(Gtk.Label(label=_("Others:")), False, False, 0)
        self.others = Gtk.Entry(width_chars=24)
        self.others.set_tooltip_text(
            _("WM_CLASS names as xprop WM_CLASS shows them, separated by spaces"))
        row.pack_start(self.others, True, True, 0)
        self.pack_start(row, False, False, 0)

    def set_text(self, text):
        names = text.replace(",", " ").split()
        lower = [n.lower() for n in names]
        for name, t in self.ticks:
            t.set_active(name in lower)
        known = [n for n, _t in self.ticks]
        self.others.set_text(" ".join(n for n in names if n.lower() not in known))

    def get_value(self):
        names = [n for n, t in self.ticks if t.get_active()]
        names += self.others.get_text().replace(",", " ").split()
        return " ".join(names)


# ---- a setting: a field and "use the default" ----------------------

class Setting:
    def __init__(self, key, field, default_label):
        self.key = key
        self.field = field
        self.default = Gtk.CheckButton(label=default_label)
        self.default.connect("toggled", self.on_default)
        self.default_value = ""

    def on_default(self, *a):
        on = self.default.get_active()
        self.field.set_sensitive(not on)
        if on:
            self.field.set_text(self.default_value)

    def load(self, value, default_value):
        self.default_value = default_value
        self.default.set_active(value is None)
        self.field.set_text(default_value if value is None else value)
        self.on_default()

    def state(self):
        """None: leave it to the default."""
        return None if self.default.get_active() else self.field.get_value()


class CheckSetting:
    """A yes/no key whose default is no: ticked writes yes, unticked
    leaves the key out."""
    def __init__(self, key, label):
        self.key = key
        self.check = Gtk.CheckButton(label=label)

    def load(self, value, default_value):
        self.check.set_active((default_value if value is None else value)
                              in ("yes", "true", "1"))

    def state(self):
        return "yes" if self.check.get_active() else None


# ---- the window -----------------------------------------------------

class SettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Top bar settings"))
        self.set_default_size(620, -1)
        self.set_border_width(10)
        self.set_icon_name("preferences-desktop")
        self.connect("destroy", Gtk.main_quit)
        self.conf = ConfigFile(CONFIG)
        self.settings = []

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(box)
        nb = Gtk.Notebook()
        nb.append_page(self.appearance_page(), Gtk.Label(label=_("Appearance")))
        nb.append_page(self.menu_page(), Gtk.Label(label=_("Menu")))
        nb.append_page(self.power_page(), Gtk.Label(label=_("Power")))
        nb.append_page(self.devices_page(), Gtk.Label(label=_("Network and sound")))
        nb.append_page(self.tray_page(), Gtk.Label(label=_("Tray")))
        box.pack_start(nb, True, True, 0)

        btns = Gtk.Box(spacing=6)
        revert = Gtk.Button(label=_("Revert"))
        revert.set_tooltip_text(_("Drop the changes not applied yet and read the file again"))
        revert.connect("clicked", lambda *a: self.load())
        apply = Gtk.Button(label=_("Apply"))
        apply.get_style_context().add_class("suggested-action")
        apply.connect("clicked", lambda *a: self.apply())
        self.status = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.START)
        self.status.get_style_context().add_class("dim-label")
        btns.pack_start(revert, False, False, 0)
        btns.pack_start(self.status, True, True, 0)
        btns.pack_end(apply, False, False, 0)
        box.pack_start(btns, False, False, 0)

        self.load()

    # building pages
    def page(self):
        self.grid = Gtk.Grid(row_spacing=8, column_spacing=12, border_width=12)
        self.row = 0
        return self.grid

    def heading(self, text):
        lab = Gtk.Label(xalign=0)
        lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(text))
        if self.row:
            lab.set_margin_top(8)
        self.grid.attach(lab, 0, self.row, 3, 1)
        self.row += 1

    def note(self, text):
        lab = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=70)
        lab.get_style_context().add_class("dim-label")
        self.grid.attach(lab, 0, self.row, 3, 1)
        self.row += 1

    def add_setting(self, key, field, label, default_label=None):
        s = Setting(key, field, default_label or _("Default"))
        self.grid.attach(Gtk.Label(label=label, xalign=1), 0, self.row, 1, 1)
        field.set_hexpand(True)
        field.set_halign(Gtk.Align.START if not isinstance(field, (TextField, FontField))
                         else Gtk.Align.FILL)
        self.grid.attach(field, 1, self.row, 1, 1)
        self.grid.attach(s.default, 2, self.row, 1, 1)
        self.settings.append(s)
        self.row += 1

    def appearance_page(self):
        g = self.page()
        same = _("Same as wm2tj")
        self.heading(_("Tab at the left end"))
        self.add_setting("tab_label", TextField(16, _("none: no text")), _("Label"), _("Host name"))
        self.add_setting("tab_length", NumberField(0, 1000, "px", _("0: fit the label")),
                 _("Length"), _("Fit the label"))
        self.add_setting("gloss", GlossField(), _("Gloss"), same)
        self.add_setting("background", ColourField(), _("Flat colour"), same)
        self.add_setting("foreground", ColourField(), _("Label colour"), same)
        self.add_setting("button_background", ColourField(), _("Button"), same)
        self.add_setting("borders", ColourField(), _("Border"), same)
        self.heading(_("Bar"))
        self.add_setting("height", NumberField(8, 64, "px"), _("Height"), same)
        self.add_setting("bar_background", ColourField(), _("Background"))
        self.add_setting("text", ColourField(), _("Text colour"))
        self.add_setting("task_gloss", TaskColourField(), _("Front application"))
        self.add_setting("task_style", ChoiceField([
            ("flat", _("One colour, with a thin line of the tab colour")),
            ("gloss", _("Gloss, like the tab"))]), _("Its look"))
        self.add_setting("font", FontField(), _("Font"), same)
        self.add_setting("menu_font", FontField(), _("Menu font"))
        self.heading(_("Clock"))
        self.add_setting("clock_format", ClockField(), _("Format"))
        self.note(_("\"Same as wm2tj\" takes the value from ~/.wm2rc, "
                    "so the bar follows the window tabs."))
        return g

    def menu_page(self):
        g = self.page()
        self.heading(_("Favourites"))
        sync = CheckSetting("sync_wm2tj", _("Sync the menu with wm2tj"))
        self.grid.attach(sync.check, 0, self.row, 3, 1)
        self.settings.append(sync)
        self.row += 1
        self.note(_("Ticked: the favourites at the top of the menu are the ones of the "
                    "wm2tj right-click menu (~/.config/wm2tj/favorites), so a favourite "
                    "added or removed in the bar or in wm2tj shows in both. Unticked: "
                    "the bar keeps its own (~/.config/wm2tj-bar/favorites)."))
        self.heading(_("Session menu"))
        self.add_setting("lock_command", TextField(), _("Lock"))
        self.add_setting("logout_command", TextField(), _("Log out"))
        self.add_setting("suspend_command", TextField(), _("Suspend"))
        self.add_setting("reboot_command", TextField(), _("Restart"))
        self.add_setting("poweroff_command", TextField(), _("Shut down"))
        self.heading(_("Applications"))
        self.add_setting("terminal", TextField(), _("Terminal"))
        self.note(_("The terminal opens applications marked Terminal=true."))
        return g

    def power_page(self):
        g = self.page()
        leave = _("Leave alone")
